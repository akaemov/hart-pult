# База. Локально — из `npm run db:dev` (Prisma Postgres без Docker):
# TCP-адрес печатает `npx prisma dev ls`.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Локальная база выполняет запросы по одному, больший пул не ускоряет. На сервере — 10.
DATABASE_POOL_MAX=1

# amoCRM — долгосрочный токен приватной интеграции.
# Создаётся в amoCRM: Настройки → Интеграции → Создать интеграцию → Ключи и доступы.
AMO_SUBDOMAIN=""
AMO_LONG_LIVED_TOKEN=""
