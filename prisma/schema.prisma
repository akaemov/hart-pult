generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Роль определяет, что человек видит. Контакты покупателей скрыты от VIEWER —
/// это учётка для показа на встречах и подрядчикам.
enum Role {
  OWNER
  COMMERCIAL
  SALES_HEAD
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role
  passwordHash String
  /// Счётчик неудачных входов подряд; после пяти вход закрывается на 15 минут.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
}

/// Сессия живёт в базе, а в cookie лежит только случайный токен.
/// В базе хранится его SHA-256: утечка дампа не даёт войти ни под кем.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Каждый прогон сбора по источнику. Отсюда каждое окно пульта берёт
/// «данные на такое-то время» — второе обязательное правило ТЗ.
model SyncRun {
  id          String     @id @default(cuid())
  /// Идентификатор из lib/sync/sources.ts. Строка, а не enum: новый источник
  /// не должен требовать миграции.
  source      String
  status      SyncStatus @default(RUNNING)
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  rowsFetched Int?
  error       String?

  payloads RawPayload[]

  @@index([source, startedAt])
}

/// Ответ внешнего API целиком, как пришёл. На нём держится проваливание
/// в сделки и пересчёт задним числом, когда поменяется формула.
model RawPayload {
  id        String   @id @default(cuid())
  source    String
  endpoint  String
  fetchedAt DateTime @default(now())
  payload   Json
  syncRunId String?
  syncRun   SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@index([source, fetchedAt])
  @@index([syncRunId])
}

/// Менеджер из amoCRM. Имя нужно, чтобы в окнах стояли люди, а не id.
model AmoUser {
  id       Int      @id
  name     String
  syncedAt DateTime @updatedAt

  leads Lead[]
}

/// Сделка amoCRM — обращение. Источник правды по лидам и воронке.
///
/// Персональные данные покупателей здесь не хранятся: из списка сделок
/// открывается карточка в amoCRM, где они и так есть у того, кому положено.
/// Так пульт остаётся вне периметра хранения ПД.
model Lead {
  id                  Int       @id
  name                String
  createdAt           DateTime
  statusId            Int
  pipelineId          Int
  /// 142 и 143 — системные статусы «реализовано» и «закрыто без успеха».
  isClosed            Boolean
  /// Заполнено ли хоть одно поле источника. Считается при сборе: набор полей
  /// у аккаунта свой, и вычислять это на каждый показ страницы незачем.
  hasSource           Boolean
  /// Значение поля «Источник заявки» как есть, без перевода в канал: правила
  /// раскладки по каналам меняются, а сырое значение должно пережить их смену.
  sourceLabel         String?
  /// Значение поля «ЖК». После переноса тегов оно заполнено у 43% сделок
  /// и вернее любых догадок по названию и меткам.
  objectLabel         String?
  utmSource           String?
  utmCampaign         String?
  /// Лендинг, с которого пришла заявка: по нему определяется объект, когда
  /// в названии сделки его нет.
  referrer            String?
  /// Первый исходящий звонок после создания сделки. Денормализация: иначе
  /// каждое окно пересчитывало бы минимум по всем звонкам.
  firstOutgoingCallAt DateTime?
  /// Теги сделки: по ним опознаётся заявка с сайта и признаки вроде «#безПВ».
  tags                String[]  @default([])
  /// Бюджет сделки. Для темпа продаж нужен не только счёт квартир, но и рубли.
  price               Int?
  /// Когда сделка закрылась — успешно или нет. По этой дате считается темп
  /// продаж: дата создания говорит о потоке обращений, а не о продажах,
  /// и сделка, созданная в марте и закрытая в сентябре, попала бы не в тот месяц.
  closedAt            DateTime?
  responsibleUserId   Int?
  responsible         AmoUser?  @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)
  syncedAt            DateTime  @updatedAt

  contacts LeadContact[]
  calls    Call[]

  @@index([createdAt])
  @@index([responsibleUserId])
  @@index([closedAt])
}

/// Связь сделки с контактом. Телефония пишет звонок либо на сделку, либо
/// на контакт — без этой связи половина звонков не найдёт свою сделку.
model LeadContact {
  leadId    Int
  contactId Int
  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([leadId, contactId])
  @@index([contactId])
}

enum CallDirection {
  IN
  OUT
}

/// Звонок из примечаний amoCRM. Телефон не хранится — он есть в карточке.
model Call {
  /// id примечания в amoCRM.
  id          Int           @id
  direction   CallDirection
  createdAt   DateTime
  durationSec Int?
  /// Через какую телефонию прошёл звонок. Пустая строка, если не указана.
  provider    String
  /// К какой сделке отнесён. Null — звонок контакту, у которого нет сделки
  /// в собранном периоде: он не теряется, но в окна не попадает.
  leadId      Int?
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([createdAt])
}

/// Воронка продаж из amoCRM.
model Pipeline {
  id       Int      @id
  name     String
  sort     Int
  isMain   Boolean
  syncedAt DateTime @updatedAt

  statuses Status[]
}

/// Этап воронки. Ключ составной: системные статусы «успешно» и «закрыто»
/// имеют одинаковые id (142 и 143) во всех воронках сразу.
model Status {
  id         Int
  pipelineId Int
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  /// Порядок в воронке, как его видит отдел продаж. У «успешно» и «закрыто»
  /// он заведомо больше всех, чтобы они всегда оказывались в конце.
  sort       Int
  /// Цвет этапа из amoCRM: в пульте он тот же, что у менеджеров в CRM.
  color      String
  /// 1 — «Неразобранное», 0 — обычный этап.
  type       Int
  syncedAt   DateTime @updatedAt

  @@id([pipelineId, id])
  @@index([pipelineId, sort])
}

/// Лот из фида Profitbase и его судьба на Авито.
///
/// Ключ составной: id лота уникален внутри кабинета Profitbase, но аккаунта
/// Авито два — у «Зари» и «Пьермонта» свои, и складывать их в одну нумерацию
/// нельзя.
model AvitoAd {
  /// Идентификатор аккаунта из lib/avito.ts: zarya | piermont.
  account String
  /// <Id> из фида — он же id лота в Profitbase.
  adId    String

  rooms       Int?
  /// Общая площадь. Именно её Авито сверяет с жилой и по ней отбивает лот.
  square      Float?
  livingSpace Float?
  floor       Int?
  /// Цена в фиде. Сравнивается с ценой опубликованного объявления: расхождение
  /// значит, что Профитбейс обновил цену, а Авито ещё нет — или наоборот.
  price       Int?
  /// Есть ли лот в фиде прямо сейчас. Объявление, которое было и пропало,
  /// не удаляется: оно может висеть на Авито, и это как раз то, что ищем.
  inFeed      Boolean @default(true)

  /// Что автозагрузка сделала с лотом в последний прогон: successful,
  /// success_skipped, error_params и так далее.
  sectionSlug  String?
  sectionTitle String?
  /// Сообщения автозагрузки как есть — и ошибки, и предупреждения.
  messages     Json?
  avitoId      BigInt?
  avitoStatus  String?
  url          String?
  syncedAt     DateTime @updatedAt

  @@id([account, adId])
  @@index([account, avitoId])
}

/// Объявление, опубликованное на Авито, — то, что видит покупатель.
/// Источник правды о том, что висит в продаже прямо сейчас.
model AvitoItem {
  account  String
  avitoId  BigInt
  title    String
  address  String
  price    Int?
  status   String
  url      String
  syncedAt DateTime @updatedAt

  @@id([account, avitoId])
}

/// Лот из Profitbase: квартира или помещение со своим статусом и ценой.
///
/// Сток у застройщика ведётся в двух экземплярах: основные проекты и копии
/// «ДЛЯ АВИТО», из которых кормятся фиды. Копии здесь лежат рядом с основными,
/// а не отбрасываются: расхождение между ними — это и есть проданная квартира,
/// которая осталась в рекламе.
model Property {
  /// id лота в Profitbase. Он же <Id> в фиде Авито — по нему объявление
  /// и сходится со своим лотом.
  id          Int      @id
  projectId   Int
  projectName String
  houseId     Int?
  houseName   String
  /// Номер квартиры. Вместе с домом образует пару, по которой лот копии
  /// сходится со своим двойником в основном проекте.
  number      String
  floor       Int?
  rooms       Int?
  /// Студия. В Profitbase у неё стоит одна комната, и без этого признака
  /// студии смешиваются с однушками — а продаются они по-разному.
  studio      Boolean  @default(false)
  areaTotal   Float?
  areaLiving  Float?
  /// AVAILABLE, SOLD, BOOKED, UNAVAILABLE.
  status      String
  price       Int?
  syncedAt    DateTime @updatedAt

  @@index([projectName, houseName, number])
  @@index([status])
}

/// Смена статуса лота: когда сборщик увидел, что квартира стала проданной,
/// забронированной или снова свободной.
///
/// Profitbase истории не отдаёт — только состояние на сейчас. Поэтому историю
/// пульт копит сам: без неё «темп продаж» считается лишь по сделкам amoCRM,
/// а брони и снятия с продажи не видны вовсе.
model StockChange {
  id         String   @id @default(cuid())
  propertyId Int
  /// Объект, как его зовут в компании: «Заря», «Пьермонт». Проект может быть
  /// переименован, а объект — нет.
  object     String
  houseName  String
  number     String
  rooms      Int?
  areaTotal  Float?
  price      Int?
  fromStatus String
  toStatus   String
  changedAt  DateTime @default(now())

  @@index([object, changedAt])
  @@index([toStatus, changedAt])
}

/// Срез остатков на день: сколько и на какую сумму свободно, забронировано
/// и продано. Одна строка на объект в день — для динамики, где поштучный
/// журнал изменений избыточен.
model StockDaily {
  /// Календарный день по месту объекта (Екатеринбург), сохранённый как дата UTC.
  day         DateTime
  object      String
  available   Int
  booked      Int
  sold        Int
  unavailable Int
  /// Метры и деньги — только по свободным: это и есть остаток, который
  /// предстоит продать.
  availableArea  Float
  availableValue Float
  syncedAt    DateTime @updatedAt

  @@id([day, object])
  @@index([object, day])
}
